# CashX backend — шаблон конфигурации. Скопируйте в .env и заполните [REQUIRED].
CASHX_ENV=development
CASHX_PORT=8080

# [REQUIRED] Postgres
CASHX_DATABASE_URL=postgres://cashx_app:change-me@localhost:5436/cashx?sslmode=disable
CASHX_ADMIN_DATABASE_URL=postgres://cashx:change-me@localhost:5436/cashx?sslmode=disable

# Test DBs
CASHX_TEST_DATABASE_URL=postgres://cashx_app:change-me@localhost:5436/cashx_test?sslmode=disable
CASHX_TEST_ADMIN_DATABASE_URL=postgres://cashx:change-me@localhost:5436/cashx_test?sslmode=disable

CASHX_REDIS_ADDR=localhost:6381

CASHX_SESSION_TTL=720h
CASHX_SESSION_COOKIE=cashx_session
# [REQUIRED]
CASHX_SESSION_SECRET=change-me-32bytes

CASHX_FRONTEND_ORIGIN=http://localhost:3000
CASHX_API_ORIGIN=http://localhost:8080
CASHX_REDIRECT_BASE=http://localhost:8081
CASHX_WEB_ORIGIN=http://localhost:3000

# [REQUIRED] Секрет подписи click-токенов
CASHX_CLICK_TOKEN_SECRET=change-me
CASHX_CLICK_TOKEN_TTL=2160h

CASHX_RATE_LIMIT=true

# [REQUIRED] Шифрование ключей интеграций
CASHX_INTEGRATION_KEY_ENCRYPTION_KEY=change-me-32bytes

CASHX_ADMIN_EMAIL=admin@cashx.local
# [REQUIRED]
CASHX_ADMIN_PASSWORD=change-me

CASHX_SMTP_FROM=no-reply@cashx.local
CASHX_SMTP_HOST=
CASHX_SMTP_PORT=587
CASHX_SMTP_USERNAME=
CASHX_SMTP_PASSWORD=
